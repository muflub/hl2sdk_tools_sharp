<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the 3x3 rooms sample (samples/rooms-3x3) from SourceSharp.MapGen's
    generator, checks a folder against it, or lists the arrangements the
    tests verify.

    The files themselves are built in MapGen, where the tests read them back
    and hold the checked-in copy to them; this is only the part that touches
    the disk.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SourceSharp.MapGen\SourceSharp.MapGen.csproj" />
  </ItemGroup>

</Project>
