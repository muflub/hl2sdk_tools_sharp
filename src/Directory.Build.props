<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Deterministic layout generation depends on stable metadata ordering. -->
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      One output folder for the whole solution: <repo>/bin/Release or
      <repo>/bin/Debug. ssmap, the optional Gpu and Cache.Sqlite backends and
      the tests all land side by side, so ssmap finds the backends it loads by
      name without staging them by hand. obj/ stays per project.
    -->
    <OutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'bin', '$(Configuration)'))</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!--
      Two warnings promoted to errors, and only two.

      CS0108 and CS0114 are the member-hiding pair: a member that shadows one it
      inherits, silently. The compiler says so on every build; here the build is
      made to stop. Not TreatWarningsAsErrors — that promotes whatever the
      CURRENT SDK's analysers happen to warn about, so a .NET update would stop
      this build for reasons that have nothing to do with the code. These two
      are language rules rather than analyser opinions: they do not drift.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0108;CS0114</WarningsAsErrors>
  </PropertyGroup>
</Project>
